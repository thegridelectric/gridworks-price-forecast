# Copy to .env (gitignored) and fill in. Settings use the GWPF_ prefix.

# ISO-NE web services account (https://webservices.iso-ne.com), basic auth.
GWPF_ISONE_USER=you@example.com
GWPF_ISONE_API_PASS=

# The service's registered GNode alias (the forecast's FromGNodeAlias).
GWPF_SERVICE_ALIAS=hw1.isone.price

# GWPF_P_NODE_ALIAS=hw1.isone.ver.keene
# GWPF_ISONE_LOCATION_ID=43790
# GWPF_TARIFF_ALIAS=versant.a1.home.eco.bonus
# GWPF_API_PORT=8532
