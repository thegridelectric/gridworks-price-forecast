# Copy to .env (gitignored) and fill in. Settings use the GWPF_ prefix.

# ISO-NE web services account (https://webservices.iso-ne.com), basic auth.
GWPF_ISONE_USER=you@example.com
GWPF_ISONE_API_PASS=

# The service's GNode: its alias (the forecast's FromGNodeAlias) and the
# g.node.gt.json that records it. The alias must match the record's.
GWPF_SERVICE_ALIAS=d1.price
GWPF_G_NODE_PATH=scripts/dev-g.node.gt.json

# The broker. The default is the local dev broker.
# GWPF_RABBIT__URL=
# GWPF_MY_SUPER_ALIAS=d1.super
# GWPF_MY_TIME_COORDINATOR_ALIAS=d1.time

# The market the forecast is for, and the node ISO-NE prices it at.
# GWPF_MARKET_MAKER_ALIAS=d1.isone.me.versant.keene
# GWPF_PRODUCT_NAME=rt60gate5
# GWPF_ISONE_LOCATION_ID=43790

# GWPF_DATA_DIR=
# GWPF_API_PORT=8532
