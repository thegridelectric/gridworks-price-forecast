[Unit]
Description=GridWorks price forecast — ISO-NE watcher and forecast broadcast
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=price
# Repo root as CWD so `.env` at the repo root resolves.
WorkingDirectory=/home/price/gridworks-price-forecast
ExecStart=/home/price/gridworks-price-forecast/.venv/bin/gwpf rabbit
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
